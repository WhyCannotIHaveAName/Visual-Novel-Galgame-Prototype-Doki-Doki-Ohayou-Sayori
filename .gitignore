# Ren'Py generated files
**/cache/
**/saves/
**/*.rpyc
**/*.rpymc
**/*.rpyb

# Compiled and packaged files
**/*.exe
**/*.zip
**/*.dat

# Logs and temporary files
**/log.txt
**/errors.txt
**/traceback.txt
**/*.bak
**/*.old
**/*.new
**/*.deepseek
**/.vscode/

# Fonts temporarily excluded until licenses are documented
**/*.ttf

# Bundled RenPy Chinese font; license in RenPy/licenses.
!RenPy/game/SourceHanSansLite.ttf

# Native verification outputs (isolated saves and screenshots).
RenPy/qa-results/
RenPy/tmp/

# The unpacked Windows release is intentionally versioned, including its
# executable, compiled scripts, fonts, and bundled runtime.
!Windows/OhayouSayori-2.1-win/**
Windows/OhayouSayori-2.1-win/**/saves/
Windows/OhayouSayori-2.1-win/**/cache/
Windows/OhayouSayori-2.1-win/**/log.txt
Windows/OhayouSayori-2.1-win/**/errors.txt
Windows/OhayouSayori-2.1-win/**/traceback.txt

# These five files are generated by the release builder and ship in the
# verified archive; they are not player saves or local testing data.
!Windows/OhayouSayori-2.1-win/game/cache/
Windows/OhayouSayori-2.1-win/game/cache/*
!Windows/OhayouSayori-2.1-win/game/cache/build_info.json
!Windows/OhayouSayori-2.1-win/game/cache/bytecode-312.rpyb
!Windows/OhayouSayori-2.1-win/game/cache/py3analysis.rpyb
!Windows/OhayouSayori-2.1-win/game/cache/screens.rpyb
!Windows/OhayouSayori-2.1-win/game/cache/shaders.txt
